# ==========================================
# EduMarks — Workspace .gitignore Configuration
# ==========================================

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Environments & Secrets ---
server/
env/
venv/
ENV/
.env
*.env

# --- Django Database, Uploads & Built Assets ---
*.sqlite3
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
marksheet/media/
marksheet/staticfiles/

# --- Node.js & Dependency Packages ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache

# --- IDEs, Operating System & Agent Tools ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.gemini/